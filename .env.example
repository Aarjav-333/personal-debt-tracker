# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> anon / public key.
# This key is safe to expose in the browser: every table is protected by
# Row Level Security, so it can only ever read the signed-in user's own rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of the deployment. Used to build Supabase auth redirect URLs.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NEVER put the Supabase service_role key in this project.
# It bypasses Row Level Security and this app has no server-side need for it.
# ---------------------------------------------------------------------------
